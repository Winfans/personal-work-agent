{
  "name": "personal-work-agent-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal Electron application written in TypeScript.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs",
    "dev": "tsc --watch",
    "electron:install": "node scripts/install-electron.mjs",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^38.0.0",
    "typescript": "^5.9.0"
  }
}
